rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all unspecified document paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Isolated Private User Data: Authenticated user can ONLY read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
